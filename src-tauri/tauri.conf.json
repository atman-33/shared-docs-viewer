{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shared-docs-viewer",
  "identifier": "com.atman33.shared-docs-viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "shared-docs-viewer",
        "visible": false,
        "dragDropEnabled": false,
        "width": 1020,
        "height": 700,
        "minWidth": 720,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "resources": [
      "resources/skills/diagram-edit/SKILL.md",
      "resources/skill-rules/diagrams.md",
      "resources/skill-rules/mindmaps.md",
      "resources/skill-rules/schedules.md"
    ]
  }
}
